{
  "schema_version": 1,
  "substrate": "claude",
  "database": "anamnema",
  "collections": {"conversation": "conversations", "summary": "summaries", "closing": "closings", "receipt": "import_receipts"},
  "batch_size": 100,
  "max_file_bytes": 536870912,
  "max_document_bytes": 15000000,
  "compression_preset": 6,
  "timeout_ms": 5000,
  "keyring_entry": "archive/mongodb",
  "keyring_field": "uri",
  "keyring_timeout_seconds": 30.0,
  "bus_env": "DBUS_SESSION_BUS_ADDRESS",
  "bus_fallback": "unix:path=/run/user/{uid}/bus",
  "reader": {
    "record_type": "type", "timestamp": "timestamp", "native_id": "uuid",
    "summary_flag": "isCompactSummary", "conversation_types": ["user", "assistant", "A"],
    "summary_types": [], "encoding": "utf-8"
  }
}

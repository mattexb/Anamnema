{
  "schema_version": 1,
  "timeout_seconds": 120.0,
  "rerank_timeout_seconds": 1.5,
  "max_request_bytes": 8388608,
  "max_response_bytes": 8388608,
  "embeddings_path": "/v1/embeddings",
  "tokenize_path": "/tokenize",
  "detokenize_path": "/detokenize",
  "rerank_path": "/v1/rerank",
  "encoder_model": "e5-small-v2-q8_0",
  "dimensions": 384,
  "query_prefix": "query: ",
  "passage_prefix": "passage: ",
  "input_characters": 1000,
  "chunk_overlap": 200,
  "max_tokens": 512,
  "cut_attempts": 4,
  "batch": 32,
  "max_documents": 100,
  "encoder_keyring_entry": "encoder/local",
  "reranker_keyring_entry": "reranker/local",
  "token_field": "token"
}
